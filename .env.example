# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Django ---------------------------------------------------------------
# Any string works for local development. Generate a real one for production:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=insecure-dev-key-for-django
DJANGO_DEBUG=True

# Comma-separated hostnames. Add your deployment host in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Scheme-qualified origins, comma-separated. Required in production for POSTs
# over HTTPS, e.g. https://lesson-scheduler-uva-swe-19fc691db615.herokuapp.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Optional. Omit to use SQLite. Heroku sets this automatically.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/djschedule
# DJANGO_POSTGRES_SSL_REQUIRE=False

# --- Google OAuth (django-allauth) ----------------------------------------
# From a Google Cloud project -> APIs & Services -> Credentials -> OAuth
# client ID (Web application). Authorized redirect URI must be:
#   http://localhost:8000/accounts/google/login/callback/
#   https://lesson-scheduler-uva-swe-19fc691db615.herokuapp.com/accounts/google/login/callback/
CLIENT_ID=
CLIENT_SECRET=
GOOGLE_KEY=

# --- S3 media storage (optional) ------------------------------------------
# Leave blank to store uploads on the local filesystem instead. When set, use
# an IAM user scoped to this one bucket -- not root or administrator keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
